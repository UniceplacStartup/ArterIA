# ==============================================================================
# ARTERIA FRONTEND — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para `.env` na pasta `frontend/`.
# ATENÇÃO: Variáveis com prefixo VITE_ são expostas ao navegador.
# NUNCA coloque chaves secretas de banco de dados (Neon) ou JWT_SECRET_KEY aqui!
# ==============================================================================

# URL base do Backend Python (FastAPI)
VITE_API_URL="http://localhost:8000/api"

# Define se o frontend deve usar dados simulados em memória ('true')
# ou conectar diretamente ao Backend Python + Neon PostgreSQL ('false')
VITE_USE_MOCKS="false"

