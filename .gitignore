# ==============================================================================
# ARTERIA MONOREPO — .gitignore GLOBAL
# ==============================================================================

# Variáveis de ambiente e segredos (CRÍTICO DE SEGURANÇA)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.crt

# Bancos de dados locais de desenvolvimento (SQLite)
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3

# Frontend (Node / Vite)
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
*.log

# Backend (Python / FastAPI)
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Cofre de arquivos médicos sensíveis (DICOM, PDF e Imagens enviadas)
storage/
**/storage/
*.dcm

# Editores e SO
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
