# ==============================================================================
# ARTERIA BACKEND — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# ATENÇÃO DE SEGURANÇA:
# NUNCA versione o arquivo `.env` real no Git! Copie este arquivo para `.env`
# e preencha com valores gerados de forma criptograficamente segura.
# ==============================================================================

# --- Ambiente de Execução ---
# Valores aceitos: development | staging | production
ENVIRONMENT=development
DEBUG=false
APP_NAME="ArterIA API"
API_V1_STR="/api"

# --- Inteligência Artificial: Google Gemini API (Gratuita no Google AI Studio) ---
# Crie sua chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Banco de Dados PostgreSQL (Neon Serverless Postgres) ---
# Copie a string de conexão "Pooled connection" do painel do Neon.
# O parâmetro sslmode=require garante criptografia TLS em trânsito.
# Exemplo: postgresql+psycopg://usuario:senha@ep-nome-pooler.us-east-2.aws.neon.tech/arteria?sslmode=require
DATABASE_URL="postgresql+psycopg://neondb_owner:SUA_SENHA_AQUI@ep-exemplo-pooler.sa-east-1.aws.neon.tech/arteria_db?sslmode=require"

# --- Segurança de Autenticação (JWT) ---
# Gere uma chave secreta de 64 bytes hexadecimais com:
# python scripts/gerar_chaves_seguranca.py
JWT_SECRET_KEY="GERE_UMA_CHAVE_SECRETA_ALEATORIA_COM_PELO_MENOS_64_CARACTERES_AQUI"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Proteção de Dados Sensíveis (LGPD / Criptografia em Repouso) ---
# Chave Fernet (AES-128-CBC + HMAC-SHA256) em Base64 URL-safe para criptografar CPF, E-mail e Dados Clínicos.
DATA_ENCRYPTION_KEY="GERE_UMA_CHAVE_FERNET_VALIDA_DE_32_BYTES_BASE64_AQUI="

# Pepper secreto usado para Blind Indexing (HMAC-SHA256) de CPFs e E-mails.
BLIND_INDEX_PEPPER="GERE_UM_PEPPER_SECRETO_HEXADECIMAL_DE_64_CARACTERES_AQUI"

# --- CORS e Segurança de Rede ---
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Armazenamento Seguro de Imagens Médicas (DICOM / PDF) ---
DICOM_STORAGE_DIR="./storage/dicom_vault"
MAX_DICOM_SIZE_MB=100

# --- Rate Limiting (Proteção contra Força Bruta e Abuso) ---
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=15
